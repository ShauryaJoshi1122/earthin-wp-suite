# Earthin Plugin Hub Environment Variables (Template)
# Copy to .env.local for local development. DO NOT commit actual secrets.

# Application Configuration
NEXT_PUBLIC_SITE_URL=https://plugins.earthin.online
NEXT_PUBLIC_APP_NAME="Earthin Plugin Hub"
NODE_ENV=development

# Database Configuration (Planned PostgreSQL / Prisma)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/earthin_plugin_hub?schema=public

# Authentication (Planned NextAuth / JWT secret)
AUTH_SECRET=placeholder_secret_replace_in_production_min_32_chars

# Storage and Asset Distribution (local | s3 | r2)
STORAGE_DRIVER=local
STORAGE_BUCKET=earthin-releases
